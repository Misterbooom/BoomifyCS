; ModuleID = 'test'
source_filename = "test"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

define float @f() {
entry:
  ret float 1.000000e+00
}

define void @main() {
entry:
  %arr = alloca [3 x i32], align 4
  store [3 x i32] [i32 1, i32 2, i32 3], ptr %arr, align 4
  ret void
}

!llvm.module.flags = !{!0, !1, !2}
!llvm.dbg.cu = !{!3}

!0 = !{i32 2, !"Debug Info Version", i32 3}
!1 = !{i32 1, !"Dwarf Version", i32 4}
!2 = !{i32 1, !"PIC Level", i32 2}
!3 = distinct !DICompileUnit(language: DW_LANG_C, file: !4, producer: "BoomifyCS Compiler", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, debugInfoForProfiling: true)
!4 = !DIFile(filename: "test.bify", directory: "/home/artur/RiderProjects/BoomifyCS")
