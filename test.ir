; ModuleID = 'test'
source_filename = "test"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

%Printer = type { i32, ptr }

@NullError = private unnamed_addr constant [10 x i8] c"NullError\00", align 1
@"Null pointer encountered." = private unnamed_addr constant [26 x i8] c"Null pointer encountered.\00", align 1
@"/home/artur/RiderProjects/BoomifyCS/test.bify" = private unnamed_addr constant [46 x i8] c"/home/artur/RiderProjects/BoomifyCS/test.bify\00", align 1
@"Integer: %d\0A" = private unnamed_addr constant [13 x i8] c"Integer: %d\0A\00", align 1
@"String: %s\0A" = private unnamed_addr constant [12 x i8] c"String: %s\0A\00", align 1

define void @Printer.constructor(ptr %0, i32 %1) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  %a = alloca i32, align 4
  store i32 %1, ptr %a, align 4
  %loaded_this = load ptr, ptr %this, align 8
  %2 = getelementptr %Printer, ptr %loaded_this, i32 0, i32 0
  %loaded_a = load i32, ptr %a, align 4
  call void @nullPointerCheck(ptr %2)
  %dereferenced_ptr = load i32, ptr %2, align 4
  store i32 %loaded_a, ptr %2, align 4
  ret void
}

define void @nullPointerCheck(ptr %0) {
entry:
  %nullCheck = icmp eq ptr %0, null
  br i1 %nullCheck, label %then, label %else

then:                                             ; preds = %entry
  call void @printError(ptr @NullError, ptr @"Null pointer encountered.", ptr @"/home/artur/RiderProjects/BoomifyCS/test.bify", i32 5)
  unreachable

else:                                             ; preds = %entry
  ret void
}

declare void @printError(ptr, ptr, ptr, i32)

define void @Printer.constructor.1(ptr %0, ptr %1) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  %b = alloca ptr, align 8
  store ptr %1, ptr %b, align 8
  %loaded_this = load ptr, ptr %this, align 8
  %2 = getelementptr %Printer, ptr %loaded_this, i32 0, i32 1
  %loaded_b = load ptr, ptr %b, align 8
  call void @nullPointerCheck(ptr %2)
  %dereferenced_ptr = load ptr, ptr %2, align 8
  store ptr %loaded_b, ptr %2, align 8
  ret void
}

define void @Printer.print(ptr %0, i32 %1) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  %a = alloca i32, align 4
  store i32 %1, ptr %a, align 4
  %loaded_a = load i32, ptr %a, align 4
  call void @pushFrame(i32 11, ptr @"/home/artur/RiderProjects/BoomifyCS/test.bify")
  %printfCall = call i32 (ptr, ...) @printf(ptr @"Integer: %d\0A", i32 %loaded_a)
  call void @popFrame()
  ret void
}

declare void @pushFrame(i32, ptr)

declare i32 @printf(ptr, ...)

declare void @popFrame()

define void @Printer.print.2(ptr %0, ptr %1) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  %b = alloca ptr, align 8
  store ptr %1, ptr %b, align 8
  %loaded_b = load ptr, ptr %b, align 8
  call void @pushFrame(i32 14, ptr @"/home/artur/RiderProjects/BoomifyCS/test.bify")
  %printfCall = call i32 (ptr, ...) @printf(ptr @"String: %s\0A", ptr %loaded_b)
  call void @popFrame()
  ret void
}

define void @main() {
entry:
  ret void
}

!llvm.module.flags = !{!0, !1, !2}
!llvm.dbg.cu = !{!3}

!0 = !{i32 2, !"Debug Info Version", i32 3}
!1 = !{i32 1, !"Dwarf Version", i32 4}
!2 = !{i32 1, !"PIC Level", i32 2}
